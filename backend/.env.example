# Server
PORT=5000

# MongoDB Atlas connection string
# Replace <username>, <password> and <cluster> with your Atlas details.
# URL-encode special characters in the password (for example @ becomes %40).
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/tea_factory_db?retryWrites=true&w=majority

# Allowed frontend origin(s), comma separated
CLIENT_URL=http://localhost:5173
